+        if cached is None or cached[0] is not free:
+            clearance=distance_transform_edt(np.pad(free,1))[1:-1,1:-1]*self.grid.config.resolution
+            costs=1.+(.15/np.maximum(clearance,.025))**2
+            self._route_cost_cache=(free,costs)
+        return self._route_cost_cache[1]
+
+    def _segment_cost(self,a,b):
+        a=np.asarray(a);b=np.asarray(b);length=float(np.linalg.norm(b-a))

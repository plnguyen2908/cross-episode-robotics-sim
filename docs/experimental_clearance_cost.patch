+        samples=a+(b-a)*np.linspace(0.,1.,max(2,int(np.ceil(length/self.grid.config.resolution))+1))[:,None]
+        cells=np.array([self.cell(p) for p in samples]);costs=self._route_costs()
+        return length*float(costs[cells[:,0],cells[:,1]].mean())

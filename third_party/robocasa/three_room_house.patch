+"""Generate seeded layout 1002; optionally compile and render native RoboCasa."""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import secrets
+import numpy as np
+import yaml
+
+ROOT=Path(__file__).resolve().parents[2]
+
+
+def load_generator():
+    spec=importlib.util.spec_from_file_location('dining_geometry',
+        ROOT/'robocasa/models/scenes/dining_room.py')
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    return module
+
+
+def draw(layout,meta,output):
+    import matplotlib
+    matplotlib.use('Agg')
+    import matplotlib.pyplot as plt
+    from mpl_toolkits.mplot3d.art3d import Poly3DCollection
+    fig=plt.figure(figsize=(12,11),facecolor='#f6f7f9')
+    ax=fig.add_subplot(111,projection='3d',computed_zorder=False)
+    def box(pos,size,color,alpha=1.):
+        x,y,z=np.asarray(pos)-np.asarray(size)/2;dx,dy,dz=size
+        v=np.array([[x,y,z],[x+dx,y,z],[x+dx,y+dy,z],[x,y+dy,z],
+                    [x,y,z+dz],[x+dx,y,z+dz],[x+dx,y+dy,z+dz],[x,y+dy,z+dz]])
+        faces=[v[i] for i in [[0,1,2,3],[0,1,5,4],[1,2,6,5],[2,3,7,6],[3,0,4,7],[4,5,6,7]]]
+        ax.add_collection3d(Poly3DCollection(faces,facecolors=color,
+            edgecolors='#59616a',linewidths=.35,alpha=alpha))
+    bottom=meta['room_bounds']['dining_room'][1]
+    box([2.75,-1.5,-.06],[5.5,3,.12],'#d7e5ef')
+    box([2.75,(bottom-3)/2,-.06],[5.5,-3-bottom,.12],'#eddcc3')
+    for f in layout['dining_room']['furniture']:
+        if f['name']=='dining_table':
+            w,d,h=f['size'];x,y,_=f['pos']
+            box([x,y,h-.02],[w,d,.04],'#a7794f')
+        else:
+            box(f['pos'],f['size'],'#a7794f' if f['name'].startswith('table_leg') else '#728c9d')
+    for w in layout['dining_room']['walls'][:2]:
+        box([w['pos'][0],-3,.55],[2*w['size'][0],.08,1.1],'#b5c2cd',.65)
+    # Native kitchen assets are not loaded in this geometric schematic.
+    for p,s,c in [([1.5,-.325,.46],[2.5,.65,.92],'#b7cbd6'),
+                  ([3.15,-.33,.46],[.8,.66,.92],'#6f7d88'),
+                  ([3.9,-.325,.46],[.7,.65,.92],'#b7cbd6'),
+                  ([4.72,-.4,.95],[.85,.8,1.9],'#c2cad1')]:box(p,s,c)
+    for x in ((0,) if 'living_room' in layout else (0,5.5)):box([x,bottom/2,.18],[.06,-bottom,.36],'#cad0d5')
+    box([2.75,bottom,.18],[5.5,.06,.36],'#cad0d5')
+    goal=meta['manipulation_stance'];door=meta['doorway']['center']
+    ax.plot([door[0],goal[0]],[door[1],goal[1]],[.04,.04],'--',color='#268b72',lw=2)
+    for text,p in [('KITCHEN',[1.5,-1.7,.08]),('DINING ROOM',[2.75,bottom+.4,.08]),
+                   ('Clear manipulation side',[goal[0],goal[1],.16]),
+                   ('Open passage',[door[0],door[1],.12])]:
+        ax.text(*p,text,ha='center',fontsize=10,zorder=20)
+    east=5.5
+    if 'living_room' in layout:
+        east=meta['room_bounds']['living_room'][2]
+        cx=(5.5+east)/2
+        box([cx,(bottom-3)/2,-.06],[east-5.5,-3-bottom,.12],'#dce8d6')
+        for f in layout['living_room']['furniture']:
+            if f['name']=='coffee_table':
+                w,d,h=f['size'];x,y,_=f['pos']
+                box([x,y,h-.02],[w,d,.04],'#a7794f')
+            else:
+                box(f['pos'],f['size'],'#819b86' if f['name'].startswith('sofa') else '#a7794f')
+        for w in layout['dining_room']['walls']:
+            if w['name'].startswith('east_'):
+                box([5.5,w['pos'][1],.55],[.08,2*w['size'][0],1.1],'#b5c2cd',.65)
+        for y in (bottom,-3):
+            box([cx,y,.18],[east-5.5,.06,.36],'#cad0d5')
+        box([east,(bottom-3)/2,.18],[.06,-3-bottom,.36],'#cad0d5')
+        route=np.asarray(meta['connecting_route'])
+        ax.plot(route[:,0],route[:,1],np.full(len(route),.04),'--',color='#268b72',lw=2)
+        ax.text(cx,bottom+.15,.1,'LIVING ROOM',ha='center',fontsize=11)
+    ax.set(xlim=(-.3,east+.3),ylim=(bottom-.3,.4),zlim=(0,2.7),xlabel='X (m)',ylabel='Y (m)')
+    ax.set_box_aspect([east,-bottom,2.7]);ax.view_init(elev=48,azim=-62);ax.grid(False)
+    fig.suptitle(f'Kitchen + randomized dining/living rooms · seed {meta["seed"]}',fontsize=18)
+    fig.text(.5,.045,'Geometry preview, not a simulator render. Kitchen fixture envelopes approximate.\nDining geometry matches the generated layout; outer walls cut down for visibility.',ha='center',fontsize=10)
+    fig.savefig(output/'layout_3d.png',dpi=150,bbox_inches='tight');plt.close(fig)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--seed',type=int)
+    p.add_argument('--rooms',type=int,choices=(2,3),default=2)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--render',action='store_true',help='Requires installed RoboSuite and RoboCasa assets')
+    args=p.parse_args();seed=args.seed if args.seed is not None else secrets.randbits(32)
+    args.output.mkdir(parents=True,exist_ok=True)
+    generator=load_generator()
+    builder=generator.build_three_room_layout if args.rooms == 3 else generator.build_dining_layout
+    layout,meta=builder(np.random.default_rng(seed))
+    if args.render:
+        try:
+            import robosuite
+            from robocasa.environments.kitchen.kitchen import Kitchen
+            import mujoco
+            import imageio.v2 as imageio
+        except ImportError as exc:
+            raise SystemExit('Native rendering requires RoboSuite and RoboCasa assets; see KITCHEN_LIVING_ROOM.md. '+str(exc)) from exc
+        class KitchenDiningRoomPreview(Kitchen):
+            def _get_obj_cfgs(self): return []
+            def _check_success(self): return False
+        env=None
+        try:
+            env=robosuite.make('KitchenDiningRoomPreview',robots='PandaOmron',
+                layout_ids=[meta["layout_id"]],seed=seed,init_robot_base_ref='counter_right_main_group',
+                use_camera_obs=False,has_renderer=False,has_offscreen_renderer=False)
+            env.reset();env.sim.forward()
+            layout=env.mujoco_arena.generated_layout;meta=env.mujoco_arena.room_metadata
+            meta.update(simulation_tested=True,style_id=int(env.style_id))
+            model=getattr(env.sim.model,'_model',env.sim.model)
+            data=getattr(env.sim.data,'_data',env.sim.data)
+            (args.output/'scene.xml').write_text(env.model.get_xml())
+            model.vis.global_.offwidth=max(model.vis.global_.offwidth,1600)
+            model.vis.global_.offheight=max(model.vis.global_.offheight,1200)
+            with mujoco.Renderer(model,height=1200,width=1600) as renderer:
+                camera=mujoco.MjvCamera();camera.lookat[:]=[2.75,-4.,.5]
+                camera.lookat[0]=5. if args.rooms == 3 else 2.75
+                camera.distance=16. if args.rooms == 3 else 12.;camera.azimuth=90.;camera.elevation=-55.
+                options=mujoco.MjvOption();options.geomgroup[0]=0
+                renderer.update_scene(data,camera=camera,scene_option=options)
+                imageio.imwrite(args.output/'native_scene.png',renderer.render())
+                # Hide only foreground walls in this extra camera view.
+                # Modify render geoms, preserving the simulation collision world.
+                for geom in renderer.scene.geoms[:renderer.scene.ngeom]:
+                    if geom.objtype != mujoco.mjtObj.mjOBJ_GEOM or geom.objid < 0:
+                        continue
+                    name=mujoco.mj_id2name(model,mujoco.mjtObj.mjOBJ_GEOM,geom.objid) or ''
+                    if name.startswith(('front_dining_room_', 'south_living_room_', 'east_south_dining_room_')):
+                        geom.rgba[3]=0
+                imageio.imwrite(args.output/'native_cutaway.png',renderer.render())
+                camera.elevation=-90.
+                renderer.update_scene(data,camera=camera,scene_option=options)
+                imageio.imwrite(args.output/'native_topdown.png',renderer.render())
+        finally:
+            if env is not None:env.close()
+    meta.update(seed=seed,navigation_tested=False,manipulation_tested=False)
+    (args.output/'layout.yaml').write_text(yaml.safe_dump(layout,sort_keys=False))
+    (args.output/'rooms.json').write_text(json.dumps(meta,indent=2)+'\n')
+    draw(layout,meta,args.output)
+    print(json.dumps(dict(output=str(args.output),seed=seed,chair_count=meta['chair_count'],
+                         simulation_tested=meta['simulation_tested'])))
+
+
+if __name__=='__main__':main()

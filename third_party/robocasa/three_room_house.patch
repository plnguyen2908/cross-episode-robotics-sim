diff --git a/robocasa/models/objects/objects.py b/robocasa/models/objects/objects.py
index 413e8aa..9a4a8dd 100644
--- a/robocasa/models/objects/objects.py
+++ b/robocasa/models/objects/objects.py
@@ -201,6 +201,31 @@ class MJCFObject(MujocoXMLObjectRobocasa):
     Blender object with support for changing the scaling
     """
 
+    def get_grasp_annotations(self, robot="franka_tidybot"):
+        """Physically qualified object-local TCP poses for this exact scale.
+
+        Optional sidecars never change the mesh or object sampling. Entries
+        for another robot, scale, or source XML are not silently reused.
+        They still require fresh reachability/collision planning in a new scene.
+        """
+        import hashlib
+        import json
+        import re
+        from pathlib import Path
+        if not re.fullmatch(r"[a-zA-Z0-9_]+", robot):
+            raise ValueError("Invalid robot annotation identifier")
+        model = Path(self.mjcf_path)
+        path = model.parent / f"grasp_annotations_{robot}.json"
+        if not path.is_file():
+            return []
+        payload = json.loads(path.read_text())
+        digest = hashlib.sha256(model.read_bytes()).hexdigest()
+        return [record for record in payload.get("grasps", [])
+                if record.get("robot") == robot
+                and record.get("model_sha256") == digest
+                and np.asarray(record.get("object_scale", [])).shape == self._scale.shape
+                and np.allclose(record["object_scale"], self._scale, rtol=0, atol=1e-8)]
+
     def __init__(
         self,
         name,

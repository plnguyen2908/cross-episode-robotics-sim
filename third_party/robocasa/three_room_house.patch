+"""Preview local layout 1001. No navigation or manipulation policy is executed."""
+import argparse
+import json
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+LAYOUT = ROOT / 'robocasa/models/assets/scenes/kitchen_layouts/custom/kitchen_living_room.yaml'
+
+
+def validate_layout(output):
+    import yaml
+    layout = yaml.safe_load(LAYOUT.read_text())
+    assert not any(w['name'].startswith('wall_front') for w in layout['room']['walls'])
+    furniture = {x['name']: x for x in layout['living_room']['furniture']}
+    table = furniture['side_table']
+    assert abs(table['pos'][2] + table['size'][2]/2 - .8) < 1e-8
+    # Wall applies a 4 cm length extension at each end. Account for both jambs.
+    clear_width = 1.7 - .08
+    assert clear_width > 2*.6
+    # Verify the doorway approach strip is unoccupied by living-room furniture.
+    for fixture in furniture.values():
+        x, y, _ = fixture['pos']; sx, sy, _ = fixture['size']
+        assert not (x+sx/2 > 1.9 and x-sx/2 < 3.6
+                    and y+sy/2 > -4.2 and y-sy/2 < -3.)
+    report = dict(layout_id=1001, layout=str(LAYOUT),
+                  doorway_clear_width_m=clear_width, side_table_height_m=.8,
+                  layout_checks_passed=True, simulation_tested=False)
+    (output/'layout_report.json').write_text(json.dumps(report, indent=2)+'\n')
+    # A schematic, deliberately distinct from the real simulator renders.
+    svg = ['<svg xmlns="http://www.w3.org/2000/svg" viewBox="-40 -35 650 800">',
+           '<rect x="0" y="0" width="550" height="300" fill="#e4edf5" stroke="#222"/>',
+           '<rect x="0" y="300" width="550" height="400" fill="#f6eadb" stroke="#222"/>',
+           '<path d="M190 300H360" stroke="white" stroke-width="8"/>',
+           '<g font-family="sans-serif" font-size="16" fill="#222">',
+           '<text x="160" y="80">Native RoboCasa kitchen</text>',
+           '<text x="200" y="380">Living room</text>',
+           '<text x="200" y="285">Open passage</text>']
+    for name, f in furniture.items():
+        x,y,_=f['pos']; sx,sy,_=f['size']
+        svg.append(f'<rect x="{100*(x-sx/2)}" y="{100*(-y-sy/2)}" width="{100*sx}" height="{100*sy}" fill="#ac9985" stroke="#403b35"/>')
+        if name in ('side_table','coffee_table','sofa_seat'):
+            svg.append(f'<text x="{100*(x-sx/2)}" y="{100*(-y-sy/2)-7}">{name.replace("_", " ")}</text>')
+    svg.append('<text x="0" y="740">Layout schematic; kitchen fixtures omitted here.</text></g></svg>')
+    (output/'layout.svg').write_text('\n'.join(svg))
+    return report
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--output', type=Path, required=True)
+    p.add_argument('--layout-only', action='store_true')
+    p.add_argument('--robot', default='PandaOmron')
+    args=p.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    report=validate_layout(args.output)
+    if args.layout_only:
+        print(json.dumps(report)); return
+    try:
+        import robosuite
+        import robocasa
+        import mujoco
+        import imageio.v2 as imageio
+        from robocasa.environments.kitchen.kitchen import Kitchen
+    except ImportError as exc:
+        raise SystemExit('Install RoboCasa and its RoboSuite dependency in a separate environment first. '
+                         'See robocasa/KITCHEN_LIVING_ROOM.md. Original error: '+str(exc)) from exc
+
+    class KitchenLivingRoomPreview(Kitchen):
+        def _get_obj_cfgs(self):
+            return []
+        def _check_success(self):
+            return False
+
+    env=None
+    try:
+        env=robosuite.make('KitchenLivingRoomPreview', robots=args.robot,
+            layout_ids=[1001], style_ids=[1], seed=0,
+            init_robot_base_ref='counter_right_main_group',
+            use_camera_obs=False, has_renderer=False, has_offscreen_renderer=False)
+        env.reset()
+        env.sim.forward()
+        model=getattr(env.sim.model, '_model', env.sim.model)
+        data=getattr(env.sim.data, '_data', env.sim.data)
+        (args.output/'scene.xml').write_text(env.model.get_xml())
+        with mujoco.Renderer(model, height=900, width=1100) as renderer:
+            camera=mujoco.MjvCamera()
+            camera.lookat[:]=[2.75,-3.5,.5]
+            camera.distance=10.; camera.azimuth=90.
+            for name,elevation in [('top_down',-90.),('perspective',-55.)]:
+                camera.elevation=elevation
+                renderer.update_scene(data,camera=camera)
+                imageio.imwrite(args.output/(name+'.png'),renderer.render())
+        report.update(simulation_tested=True, robot=args.robot,
+            fixture_names=list(env.fixtures),
+            task_receptacles=['counter_right_main_group','side_table_living_room'],
+            navigation_tested=False, manipulation_tested=False)
+        (args.output/'layout_report.json').write_text(json.dumps(report,indent=2)+'\n')
+        print(json.dumps(report))
+    finally:
+        if env is not None:
+            env.close()
+
+
+if __name__ == '__main__':
+    main()

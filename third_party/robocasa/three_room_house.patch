+++ b/robocasa/scripts/render_room_geometry.py
@@ -0,0 +1,74 @@
+"""Render generated room geometry in MuJoCo without external fixture assets."""
+import argparse
+import json
+import os
+from pathlib import Path
+import xml.etree.ElementTree as ET
+os.environ.setdefault('MUJOCO_GL', 'egl')
+import mujoco
+import numpy as np
+import imageio.v2 as imageio
+import yaml
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--input',type=Path,required=True)
+    args=p.parse_args()
+    layout=yaml.safe_load((args.input/'layout.yaml').read_text())
+    meta=json.loads((args.input/'rooms.json').read_text())
+    root=ET.Element('mujoco',model='three_room_geometry_preview')
+    ET.SubElement(root,'visual')
+    ET.SubElement(root.find('visual'),'global',offwidth='1600',offheight='1200')
+    ET.SubElement(root.find('visual'),'quality',shadowsize='4096')
+    world=ET.SubElement(root,'worldbody')
+    ET.SubElement(world,'light',pos='3 -4 10',dir='0 0 -1',diffuse='.8 .8 .8',castshadow='true')
+    ET.SubElement(world,'light',pos='10 -1 8',dir='-1 -1 -2',diffuse='.5 .5 .5',castshadow='false')
+    def box(name,pos,size,color):
+        ET.SubElement(world,'geom',name=name,type='box',pos=' '.join(map(str,pos)),
+                      size=' '.join(str(float(v)/2) for v in size),rgba=color,contype='0',conaffinity='0')
+    colors={'kitchen':'.71 .79 .83 1','dining_room':'.77 .64 .47 1','living_room':'.64 .74 .61 1'}
+    for name,(x0,y0,x1,y1) in meta['room_bounds'].items():
+        box(name+'_floor',[(x0+x1)/2,(y0+y1)/2,-.055],[x1-x0,y1-y0,.1],colors[name])
+    for group in ('dining_room','living_room'):
+        if group not in layout:continue
+        for f in layout[group]['furniture']:
+            name=group+'_'+f['name'];pos=list(f['pos']);size=list(f['size'])
+            color='.44 .25 .12 1' if 'table' in name or 'leg' in name else '.28 .42 .44 1'
+            if 'sofa' in name:color='.36 .47 .33 1'
+            if f['type']=='counter':pos[2]=size[2]-.02;size[2]=.04
+            box(name,pos,size,color)
+        for w in layout[group]['walls']:
+            # Cutaway walls retain actual XY boundaries and doorway gaps.
+            pos=list(w['pos']);pos[2]=.32
+            length=2*w['size'][0]+.08
+            size=[.08,length,.64] if w['wall_side'] in ('left','right') else [length,.08,.64]
+            box(group+'_'+w['name'],pos,size,'.84 .83 .79 1')
+    box('kitchen_left',[0,-1.5,.32],[.08,3,.64],'.84 .83 .79 1')
+    box('kitchen_right',[5.5,-1.5,.32],[.08,3,.64],'.84 .83 .79 1')
+    box('kitchen_back',[2.75,0,.32],[5.5,.08,.64],'.84 .83 .79 1')
+    for name,pos,size,color in [
+        ('counter',[1.5,-.325,.46],[2.5,.65,.92],'.64 .69 .70 1'),
+        ('stove',[3.15,-.33,.46],[.8,.66,.92],'.23 .27 .29 1'),
+        ('counter_right',[3.9,-.325,.46],[.7,.65,.92],'.64 .69 .70 1'),
+        ('fridge',[4.72,-.4,.95],[.85,.8,1.9],'.65 .68 .69 1')]:
+        box(name,pos,size,color)
+    box('counter_top',[1.5,-.325,.935],[2.5,.67,.03],'.91 .90 .86 1')
+    box('sink_visual',[1.5,-.325,.955],[.55,.43,.01],'.22 .27 .29 1')
+    xml=ET.tostring(root,encoding='unicode')
+    (args.input/'geometry_preview.xml').write_text(xml)
+    model=mujoco.MjModel.from_xml_string(xml);data=mujoco.MjData(model);mujoco.mj_forward(model,data)
+    bounds=np.array(list(meta['room_bounds'].values()))
+    center=[(bounds[:,0].min()+bounds[:,2].max())/2,(bounds[:,1].min()+bounds[:,3].max())/2,0]
+    with mujoco.Renderer(model,height=1200,width=1600) as renderer:
+        for name,elevation,azimuth in [('mujoco_3d',-55,105),('mujoco_topdown',-90,90)]:
+            camera=mujoco.MjvCamera();camera.lookat[:]=center;camera.distance=15.5
+            camera.elevation=elevation;camera.azimuth=azimuth
+            renderer.update_scene(data,camera=camera)
+            imageio.imwrite(args.input/(name+'.png'),renderer.render())
+    (args.input/'render_notes.json').write_text(json.dumps(dict(renderer='MuJoCo',native_robocasa_assets=False,
+        kitchen='approximate fixture envelopes',furniture='generated room geometry',walls='cutaway height 0.64m'),indent=2))
+    print(args.input/'mujoco_3d.png')
+
+
+if __name__=='__main__':main()

@@ -0,0 +1,87 @@
+"""Render native RoboCasa kitchens, preserving layouts and fixture assets."""
+import argparse
+import json
+import os
+from pathlib import Path
+os.environ.setdefault('MUJOCO_GL','egl')
+import numpy as np
+import yaml
+import mujoco
+import robosuite
+import robocasa
+from robocasa.environments.kitchen.kitchen import Kitchen
+from robocasa.models.scenes.scene_registry import get_layout_path
+from PIL import Image,ImageDraw,ImageFont
+
+class NativeKitchenGallery(Kitchen):
+    def _get_obj_cfgs(self):return []
+    def _check_success(self):return False
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--layouts',nargs='+',type=int,default=[1,2,4,9])
+    p.add_argument('--styles',nargs='+',type=int,default=[1,7,18,57])
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--three-rooms',action='store_true')
+    args=p.parse_args();args.output.mkdir(parents=True,exist_ok=True)
+    records=[];images=[]
+    for index,layout_id in enumerate(args.layouts):
+        style=args.styles[index%len(args.styles)]
+        layout=yaml.safe_load(Path(get_layout_path(layout_id)).read_text())
+        floor=next(f for group in layout.values() for fs in group.values() if isinstance(fs,list)
+                   for f in fs if isinstance(f,dict) and f.get('type')=='floor')
+        cx,cy,_=floor['pos'];w,d=2*floor['size'][0],2*floor['size'][1]
+        env=None
+        try:
+            env=robosuite.make('NativeKitchenGallery',robots='PandaOmron',layout_ids=[1100+layout_id if args.three_rooms else layout_id],
+                style_ids=[style],seed=7,use_camera_obs=False,has_renderer=False,has_offscreen_renderer=False)
+            env.reset();env.sim.forward()
+            if args.three_rooms:
+                layout=env.mujoco_arena.generated_layout
+                meta=env.mujoco_arena.room_metadata
+                bounds=np.asarray(list(meta['room_bounds'].values()))
+                cx=(bounds[:,0].min()+bounds[:,2].max())/2
+                cy=(bounds[:,1].min()+bounds[:,3].max())/2
+            model=env.sim.model._model;data=env.sim.data._data
+            model.vis.global_.offwidth=1400;model.vis.global_.offheight=1100
+            prefix=f'layout_{layout_id:03d}_style_{style:03d}'
+            (args.output/(prefix+'.xml')).write_text(env.model.get_xml())
+            if args.three_rooms:
+                (args.output/(prefix+'_rooms.json')).write_text(json.dumps(meta,indent=2))
+                (args.output/(prefix+'_layout.yaml')).write_text(yaml.safe_dump(layout,sort_keys=False))
+            options=mujoco.MjvOption();options.geomgroup[0]=0
+            with mujoco.Renderer(model,height=1100,width=1400) as renderer:
+                camera=mujoco.MjvCamera();camera.lookat[:]=[cx,cy,.65]
+                camera.distance=20. if args.three_rooms else 11.5;camera.azimuth=105;camera.elevation=-52
+                renderer.update_scene(data,camera=camera,scene_option=options)
+                # Only remove enclosing walls from the camera view, never physics.
+                hide=[]
+                for group_name,group in layout.items():
+                    for f in group.get('walls',[]):
+                        if f.get('enclosing_wall') or (args.three_rooms and group_name=='living_room' and f['name']=='south'):hide.append(f['name']+'_'+group_name+'_')
+                for geom in renderer.scene.geoms[:renderer.scene.ngeom]:
+                    if geom.objtype==mujoco.mjtObj.mjOBJ_GEOM and geom.objid>=0:
+                        name=mujoco.mj_id2name(model,mujoco.mjtObj.mjOBJ_GEOM,geom.objid) or ''
+                        if name.startswith(tuple(hide)):geom.rgba[3]=0
+                image=Image.fromarray(renderer.render());image.save(args.output/(prefix+'.png'))
+                images.append(image)
+                camera.elevation=-90;camera.azimuth=90
+                renderer.update_scene(data,camera=camera,scene_option=options)
+                Image.fromarray(renderer.render()).save(args.output/(prefix+'_topdown.png'))
+            records.append(dict(layout_id=layout_id,style_id=style,width_m=w,depth_m=d,
+                seed=7,three_rooms=args.three_rooms,rendered=True,physics_navigation_tested=False))
+            print(json.dumps(records[-1]),flush=True)
+        finally:
+            if env is not None:env.close()
+    font=ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',26)
+    columns=2;rows=(len(images)+1)//2
+    gallery=Image.new('RGB',(1600,rows*690),'#f2f3f5');draw=ImageDraw.Draw(gallery)
+    for i,(im,record) in enumerate(zip(images,records)):
+        x=(i%columns)*800;y=(i//columns)*690
+        gallery.paste(im.resize((800,629)),(x,y+55))
+        draw.text((x+18,y+14),f'Layout {record["layout_id"]:03d} / Style {record["style_id"]:03d} | {record["width_m"]:.1f} x {record["depth_m"]:.1f} m',fill='#222222',font=font)
+    gallery.save(args.output/'gallery.png')
+    (args.output/'manifest.json').write_text(json.dumps(records,indent=2))
+
+if __name__=='__main__':main()
